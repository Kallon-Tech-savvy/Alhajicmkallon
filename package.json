{
  "name": "alhajicmkallon",
  "version": "1.0.0",
  "description": "Personal portfolio and learning hub for Alhaji C M Kallon",
  "keywords": [
    "portfolio",
    "design-engineering",
    "nextjs",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kallon-Tech-savvy/Alhajicmkallon.git"
  },
  "license": "ISC",
  "author": "Alhaji C M Kallon",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test:security": "node --import tsx --test scripts/chat-security.test.mjs src/packages/chat/tests/http.test.ts",
    "test:boundaries": "node scripts/test-deep-module-boundaries.mjs",
    "predev": "node scripts/build-content-index.mjs && node scripts/build-protocol-offline.mjs",
    "prebuild": "node scripts/build-content-index.mjs && node scripts/build-protocol-offline.mjs && next typegen",
    "test:content": "node --import tsx --test scripts/build-content-index.test.mjs scripts/protocol-course.test.mjs scripts/course-progress.test.mjs scripts/protocol-offline.test.mjs scripts/search-relevance.test.mjs scripts/research-library.test.mjs src/packages/content/tests/*.test.ts",
    "test:contact": "node --test scripts/contact-form.test.mjs scripts/contact-api.test.mjs",
    "test:homepage-performance": "node --test scripts/homepage-performance.test.mjs scripts/navigation-focus.test.mjs scripts/theme.test.mjs",
    "test:browser-bundle": "node --test scripts/browser-bundle.test.mjs",
    "test:performance-report": "node --test scripts/report-main-thread.test.mjs scripts/verify-lighthouse-baseline.test.mjs",
    "test:vitals": "node --test scripts/anonymous-vitals.test.mjs",
    "lint:boundaries": "node scripts/lint-deep-module-boundaries.mjs",
    "test:chat": "node --import tsx --test src/packages/chat/tests/*.test.ts",
    "format:check": "prettier --check src --ignore-path .prettierignore",
    "test": "npm run test:chat && npm run test:security && npm run test:content && npm run test:contact && npm run test:homepage-performance && npm run test:performance-report && npm run test:vitals && node --test scripts/substack-feed.test.mjs && node --test scripts/workers-runtime-config.test.mjs",
    "test:interactions": "playwright test",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "npm run prebuild:vinext && vinext-cloudflare deploy",
    "prebuild:vinext": "node scripts/build-content-index.mjs && node scripts/build-protocol-offline.mjs",
    "preview:vinext": "npm run prebuild:vinext && vinext-cloudflare previews deploy",
    "pretypecheck": "next typegen",
    "format:write": "prettier --write src --ignore-path .prettierignore"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.4.0",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^1.23.0",
    "next": "^16.4.6",
    "openai": "^6.45.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.1",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "private": true
}
