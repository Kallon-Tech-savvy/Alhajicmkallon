    "test:homepage-performance": "node --test scripts/homepage-performance.test.mjs scripts/navigation-focus.test.mjs scripts/theme.test.mjs",
    "test:browser-bundle": "node --test scripts/browser-bundle.test.mjs",
    "test:performance-report": "node --test scripts/report-main-thread.test.mjs scripts/verify-lighthouse-baseline.test.mjs",
    "test:vitals": "node --test scripts/anonymous-vitals.test.mjs",
    "lint:boundaries": "node scripts/lint-deep-module-boundaries.mjs",
    "test:chat": "node --import tsx --test src/packages/chat/tests/*.test.ts",
    "format:check": "prettier --check src/packages/chat src/packages/content --ignore-path .prettierignore",
    "test": "npm run test:chat && npm run test:security && npm run test:content && npm run test:contact && npm run test:homepage-performance && npm run test:performance-report && npm run test:vitals && node --test scripts/substack-feed.test.mjs",
    "test:interactions": "playwright test"
